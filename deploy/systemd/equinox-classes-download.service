[Unit]
Description=equinox-classes: poll Equinox and rebuild data/
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=equinox-classes
WorkingDirectory=/srv/equinox-classes
# Each run writes a new immutable snapshot under data/raw/<timestamp>/ (kept forever) and
# republishes data/index.json + data/clubs/*.json. Non-zero exit = some clubs failed or the
# sanity check refused to publish; the previous output stays live.
ExecStart=/usr/bin/env node downloader/download.ts --out /var/lib/equinox-classes/data
Nice=10
# Hardening: it only needs the network and its data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/equinox-classes
